# =============================================================================
# MatchClass — Entorno de PRODUCCION (RC-019 / HU-16)
# =============================================================================
# Este archivo SI se versiona (RC-019/D2). Las claves VITE_FIREBASE_* son
# publicas por diseño: viajan en el bundle del navegador y lo que protege los
# datos son las Firestore Security Rules, no ocultar el apiKey. Commitearlo
# hace el build de produccion reproducible desde cualquier maquina.
#
# Vite lo carga solo en modo `production`, es decir en `npm run build`.
# `npm run dev` sigue usando `.env.local` y no se ve afectado.
#
# Si falta alguna de las cuatro claves requeridas (API_KEY, AUTH_DOMAIN,
# PROJECT_ID, APP_ID), `readFirebaseEnv()` lanza en el arranque y el sitio
# queda en pantalla en blanco. Es deliberado; no lo relajes.
# -----------------------------------------------------------------------------

# Proyecto Firebase real: `matchclass` (unico proyecto, plan Blaze).
VITE_FIREBASE_API_KEY=AIzaSyA7UBOp7-nFiHhLmPtzYVNjA-HCY-ki9ts
VITE_FIREBASE_AUTH_DOMAIN=matchclass.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=matchclass
VITE_FIREBASE_STORAGE_BUCKET=matchclass.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=633747355170
VITE_FIREBASE_APP_ID=1:633747355170:web:3acea9261e5fee8ce43c7b

# Produccion nunca usa emuladores. Con `false`, `firebase-app.ts` apunta a la
# base nombrada `matchclass-db` (RC-019/D1), no a `(default)`.
VITE_FIREBASE_USE_EMULATORS=false

VITE_APP_ENV=production

# Sentry queda fuera de alcance (RC-019/D3): la variable esta tipada pero
# ningun archivo la lee todavia. Se deja vacia a proposito.
VITE_SENTRY_DSN=
