# =============================================================================
# MatchClass — Variables de entorno
# Copiar este archivo:  cp .env.example .env.local
# =============================================================================
#
# Archivos de entorno del repo:
#
#   .env.example      Este template. Se versiona. No lo lee la app.
#   .env.local        Tu entorno de desarrollo. NO se versiona. Lo usa
#                     `npm run dev`. Normalmente apunta a los emuladores
#                     (VITE_FIREBASE_USE_EMULATORS=true), asi que las claves
#                     de Firebase pueden ser ficticias.
#   .env.production   Entorno del sitio publicado. SI se versiona (RC-019/D2).
#                     Lo lee solo `npm run build` (modo production). Apunta al
#                     proyecto real `matchclass` con USE_EMULATORS=false, lo
#                     que ademas hace que Firestore use la base nombrada
#                     `matchclass-db` en vez de `(default)` (RC-019/D1).
#
# Procedimiento de despliegue: docs/despliegue.md
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — Auth + Firestore
# -----------------------------------------------------------------------------
# Estas claves son PUBLICAS por diseño: viajan en el bundle del navegador.
# Lo que protege los datos son las Firestore Security Rules, no ocultar el apiKey.
# Se cargan por .env para poder apuntar a un proyecto distinto en cada ambiente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Emuladores locales
# -----------------------------------------------------------------------------
# true  -> la app se conecta a los emuladores (auth 9099 / firestore 8080)
# false -> la app se conecta al proyecto real de Firebase
# Con los emuladores, las claves de arriba pueden ser valores ficticios.
VITE_FIREBASE_USE_EMULATORS=true

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# development | staging | production
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Monitoreo (opcional — dejar vacío para deshabilitar)
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=
